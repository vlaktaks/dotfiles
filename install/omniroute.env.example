# Copy to ~/.config/omniroute/omniroute.env and edit as needed.
# Keep this file private (chmod 600). Do NOT commit real secrets.
#
# OmniRoute runtime
# PORT=20128
#
# OmniRoute API key behavior (see OmniRoute docs for your deployment mode)
# REQUIRE_API_KEY=false
# OMNIROUTE_API_KEY=replace-with-real-key-if-required
#
# Provider credentials (examples - configure only providers you use)
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...
#
# After editing, you can reference this file from the user service:
#   EnvironmentFile=%h/.config/omniroute/omniroute.env
# then: systemctl --user daemon-reload && systemctl --user restart omniroute
